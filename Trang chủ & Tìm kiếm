import { useEffect, useState } from 'react';
import { Link } from 'react-router-dom';
import { Post } from '../types';

export default function Home() {
  const [posts, setPosts] = useState<Post[]>([]);
  const [search, setSearch] = useState('');
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState('');

  useEffect(() => {
    const fetchPosts = async () => {
      setLoading(true);
      try {
        const response = await fetch('https://jsonplaceholder.typicode.com/posts');
        if (!response.ok) throw new Error('Lỗi khi tải dữ liệu từ server');
        const apiPosts = await response.json();
        
        // Lấy bài viết từ localStorage
        const localData = localStorage.getItem('localPosts');
        const localPosts = localData ? JSON.parse(localData) : [];

        // Gộp bài viết local lên đầu danh sách API
        setPosts([...localPosts, ...apiPosts]);
      } catch (err: any) {
        setError(err.message);
      } finally {
        setLoading(false);
      }
    };
    fetchPosts();
  }, []);

  const filteredPosts = posts.filter((post) =>
    post.title.toLowerCase().includes(search.toLowerCase())
  );

  if (loading) return <h3>Đang tải danh sách bài viết...</h3>;
  if (error) return <h3 style={{ color: 'red' }}>Lỗi: {error}</h3>;

  return (
    <div>
      <h1>Danh sách bài viết</h1>
      <input
        type="text"
        placeholder="Tìm kiếm theo tiêu đề..."
        value={search}
        onChange={(e) => setSearch(e.target.value)}
        style={{ padding: '8px', width: '300px', marginBottom: '20px' }}
      />
      
      <div style={{ display: 'flex', flexDirection: 'column', gap: '15px' }}>
        {filteredPosts.map((post) => (
          <div key={post.id} style={{ border: '1px solid #ccc', padding: '15px' }}>
            <h3>{post.title}</h3>
            <p>{post.body.substring(0, 100)}...</p>
            <Link to={`/post/${post.id}`}>Xem chi tiết</Link>
          </div>
        ))}
        {filteredPosts.length === 0 && <p>Không tìm thấy bài viết nào.</p>}
      </div>
    </div>
  );
}
